# Sao chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Khoá API Gemini. Chỉ dùng cho phát triển cục bộ.
GEMINI_API_KEY=

# Bật nhúng khoá vào bundle trình duyệt — CHỈ dùng khi phát triển cục bộ.
# Bản build production luôn bỏ qua cờ này và không bao giờ nhúng khoá.
GITA_ALLOW_CLIENT_API_KEY=false

# Địa chỉ dev server lắng nghe. Mặc định 127.0.0.1 (chỉ máy này).
# Đặt 0.0.0.0 chỉ khi cần truy cập từ máy khác trong mạng LAN tin cậy.
GITA_DEV_HOST=127.0.0.1
