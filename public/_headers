# Đầu trang HTTP cho bản web. Netlify, Cloudflare Pages và Vercel đều đọc
# tệp này; nơi đăng nào không đọc thì phải đặt lại đúng những dòng dưới đây.
#
# frame-ancestors CHỈ có hiệu lực ở đầu trang HTTP — thẻ meta trong HTML bị
# trình duyệt bỏ qua. Nên chống nhúng vào iframe nằm ở đây, không nằm trong
# index.html.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self'; worker-src 'self'; frame-src 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'

# Tệp trong /assets đều mang mã băm trong tên: đổi nội dung là đổi tên tệp.
# Nên có thể cho nhớ vĩnh viễn — người quay lại không tải lại gì cả, và đó
# là phần lớn khác biệt tốc độ giữa lần vào đầu và những lần sau.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ảnh chia sẻ cũng đổi tên khi đổi trang, nhưng để một tháng cho chắc: máy
# đọc của mạng xã hội tự làm mới theo lịch riêng của chúng.
/og/*
  Cache-Control: public, max-age=2592000

# HTML thì KHÔNG được nhớ lâu. Tên tệp không đổi khi nội dung đổi, nên nhớ
# lâu nghĩa là người dùng xem bản cũ sau khi đã phát hành bản mới.
# must-revalidate: dùng bản trong máy nhưng luôn hỏi lại máy chủ trước.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap và robots đổi mỗi lần phát hành, để máy tìm kiếm hỏi lại mỗi giờ.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
