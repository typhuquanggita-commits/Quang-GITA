{
  "name": "engwin365",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:vault": "node desktop/vault.test.cjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test:desktop": "npm run build && xvfb-run -a electron --no-sandbox desktop/smoke.cjs",
    "test:motphien": "npm run build && xvfb-run -a electron --no-sandbox desktop/mot-phien.test.cjs",
    "test": "npm run test:vault && npm run test:desktop && npm run test:motphien",
    "test:web": "node tools/kiem-ban-web.mjs",
    "audit": "npx tsc --noEmit && npm run build && npx tsx tools/kiem-so-khai.ts && python3 tools/kiem-tham-chieu.py && python3 tools/kiem-chinh-ta.py && npx tsx tools/kiem-gita.ts && npx tsx tools/kiem-chuyen.ts && npx tsx tools/kiem-tuyen.ts && npx tsx tools/kiem-phieu.ts && npx tsx tools/kiem-quyen.ts && npx tsx tools/kiem-giang-sau.ts && npx tsx tools/kiem-gita-sau.ts && npx tsx tools/kiem-giai-hoso.ts && npx tsx tools/kiem-nganhang.ts && npx tsx tools/kiem-phien.ts && npx tsx tools/kiem-bode.ts && npx tsx tools/kiem-dethi.ts && node tools/kiem-bao-mat.mjs && node tools/kiem-hieu-nang.mjs && npx tsx tools/kiem-dao-tao.ts && npx tsx tools/kiem-danh-gia.ts && npx tsx tools/kiem-tai-lieu.ts && npx tsx tools/kiem-nghe.ts && npx tsx tools/kiem-sat.ts && npx tsx tools/kiem-ielts9.ts && npm run seo && npx tsx tools/kiem-seo.mjs",
    "test:voice": "python3 tools/khop-giong.test.py",
    "test:ui": "node tools/kiem-tuong-tac.mjs",
    "test:training": "npx tsx tools/kiem-dao-tao.ts",
    "build:single": "SINGLE=1 vite build && node tools/xuat-mot-tep.mjs",
    "test:assistant": "node tools/kiem-tro-ly.mjs",
    "test:gita": "npx tsx tools/kiem-gita.ts",
    "test:chuyen": "npx tsx tools/kiem-chuyen.ts",
    "test:diem": "node tools/kiem-may-tinh-diem.mjs",
    "test:so": "npx tsx tools/kiem-so-khai.ts",
    "test:tuyen": "npx tsx tools/kiem-tuyen.ts",
    "test:thanh": "python3 tools/do-thanh-dieu.py --tu-kiem",
    "test:a11y": "npx tsx tools/kiem-tiep-can.mjs",
    "test:phieu": "npx tsx tools/kiem-phieu.ts",
    "test:quyen": "npx tsx tools/kiem-quyen.ts",
    "test:giang": "npx tsx tools/kiem-giang-sau.ts",
    "test:gitasau": "npx tsx tools/kiem-gita-sau.ts",
    "test:giai": "npx tsx tools/kiem-giai-hoso.ts",
    "test:nganhang": "npx tsx tools/kiem-nganhang.ts",
    "test:phien": "npx tsx tools/kiem-phien.ts",
    "test:baomat": "node tools/kiem-bao-mat.mjs",
    "test:bode": "npx tsx tools/kiem-bode.ts",
    "test:dethi": "npx tsx tools/kiem-dethi.ts",
    "test:hieunang": "node tools/kiem-hieu-nang.mjs",
    "seo": "npx tsx tools/sinh-anh-og.mjs && npx tsx tools/sinh-seo.mjs",
    "test:seo": "npx tsx tools/kiem-seo.mjs",
    "test:tailieu": "npx tsx tools/kiem-tai-lieu.ts",
    "build:web": "npm run build && npm run seo && npm run test:seo",
    "test:sat": "npx tsx tools/kiem-sat.ts",
    "test:ielts9": "npx tsx tools/kiem-ielts9.ts",
    "test:nghe": "npx tsx tools/kiem-nghe.ts",
    "sinh:am-nghe": "python3 tools/sinh-am-nghe.py"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "description": "ENGWIN365 — Hệ thống học tiếng Anh từ số 0 đến IELTS 8.0 trong 36 tháng",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "vn.gita365.engwin365",
    "productName": "ENGWIN365",
    "copyright": "GITA365",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/vault.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ENGWIN365-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ENGWIN365"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "portable": {
      "artifactName": "ENGWIN365-${version}-windows-portable.${ext}"
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "asar": true,
    "compression": "maximum"
  },
  "author": {
    "name": "GITA365",
    "email": "typhuquanggita@gmail.com"
  }
}
