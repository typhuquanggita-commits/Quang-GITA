{
  "name": "hsa365",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HSA365 — nen tang luyen thi Danh gia nang luc HSA (DHQGHN) theo lo trinh ca nhan hoa.",
  "scripts": {
    "dev": "vite",
    "build": "npm run seo && tsc --noEmit && vite build && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test && npm run build",
    "catalogue": "tsx scripts/export-catalogue.ts",
    "seo": "tsx scripts/export-seo.ts",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
