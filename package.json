{
  "name": "engwin365",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:vault": "node desktop/vault.test.cjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test:desktop": "npm run build && xvfb-run -a electron --no-sandbox desktop/smoke.cjs",
    "test": "npm run test:vault && npm run test:desktop",
    "test:web": "node tools/kiem-ban-web.mjs",
    "audit": "npx tsc --noEmit && npm run build && python3 tools/kiem-tham-chieu.py && python3 tools/kiem-chinh-ta.py",
    "test:voice": "python3 tools/khop-giong.test.py",
    "test:ui": "node tools/kiem-tuong-tac.mjs",
    "test:training": "npx tsx tools/kiem-dao-tao.ts",
    "build:single": "SINGLE=1 vite build && node tools/xuat-mot-tep.mjs",
    "test:assistant": "node tools/kiem-tro-ly.mjs",
    "test:gita": "npx tsx tools/kiem-gita.ts",
    "test:chuyen": "npx tsx tools/kiem-chuyen.ts",
    "test:diem": "node tools/kiem-may-tinh-diem.mjs"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "description": "ENGWIN365 — Hệ thống học tiếng Anh từ số 0 đến IELTS 8.0 trong 36 tháng",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "vn.gita365.engwin365",
    "productName": "ENGWIN365",
    "copyright": "GITA365",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/vault.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ENGWIN365-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ENGWIN365"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "portable": {
      "artifactName": "ENGWIN365-${version}-windows-portable.${ext}"
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "asar": true,
    "compression": "maximum"
  },
  "author": {
    "name": "GITA365",
    "email": "typhuquanggita@gmail.com"
  }
}